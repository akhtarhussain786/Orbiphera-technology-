<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Map API Inquiries directly to PHP handler on Apache
  RewriteRule ^api/inquiries/?$ api/inquiries.php [QSA,L]
  RewriteRule ^api/admin/inquiries/?$ api/inquiries.php [QSA,L]
  RewriteRule ^api/admin/inquiries/([^/]+)/?$ api/inquiries.php [QSA,L]
  RewriteRule ^api/admin/inquiries/([^/]+)/status/?$ api/inquiries.php [QSA,L]

  # 3. Map API Media Uploads directly to PHP handler on Apache
  RewriteRule ^api/admin/media/upload/?$ api/media_upload.php [QSA,L]
  RewriteRule ^api/media/upload/?$ api/media_upload.php [QSA,L]

  # 4. Map API Content & Products Showcase to PHP handler on Apache
  RewriteRule ^api/content/admin/([^/]+)/?$ api/content.php?key=$1 [QSA,L]
  RewriteRule ^api/content/([^/]+)/?$ api/content.php?key=$1 [QSA,L]
  RewriteRule ^api/content/?$ api/content.php [QSA,L]

  # 5. SPA Fallback: All other routes to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>
